@Composable
fun ChatListScreen(onChatClick: (Chat) -> Unit) {
    Column(modifier = Modifier.fillMaxSize()) {
        TopAppBar(title = { Text("پیام یار") })

        LazyColumn(modifier = Modifier.fillMaxSize()) {
            items(DemoData.chats) { chat ->
                ChatRow(chat = chat, onClick = { onChatClick(chat) })
                Divider()
            }
        }
    }
}

@Composable
fun ChatRow(chat: Chat, onClick: () -> Unit) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .clickable { onClick() }
            .padding(horizontal = 16.dp, vertical = 10.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier
                .size(48.dp)
                .background(Color(chat.avatarColorArgb), CircleShape),
            contentAlignment = Alignment.Center
        ) {
            Text(chat.avatarLetter, color = Color.White, fontSize = 18.sp)
        }

        Spacer(modifier = Modifier.width(12.dp))

        Column(modifier = Modifier.weight(1f)) {
            Text(chat.name, fontWeight = FontWeight.Bold)
            Spacer(modifier = Modifier.height(2.dp))
            Text(
                chat.lastMessage,
                color = Color.Gray,
                fontSize = 13.sp,
                maxLines = 1
            )
        }

        Column(horizontalAlignment = Alignment.End) {
            Text(chat.time, color = Color.Gray, fontSize = 11.sp)
            if (chat.unreadCount > 0) {
                Spacer(modifier = Modifier.height(4.dp))
                Box(
                    modifier = Modifier
                        .size(20.dp)
                        .background(Color(0xFF0E9BB9), CircleShape),
                    contentAlignment = Alignment.Center
                ) {
                    Text(
                        chat.unreadCount.toString(),
                        color = Color.White,
                        fontSize = 11.sp
                    )
                }
            }
        }
    }
