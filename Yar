sealed class Screen {
    object ChatsTab : Screen()
    object ContactsTab : Screen()
    object SettingsTab : Screen()
    data class ChatDetail(val chat: Chat) : Screen()
}

@Composable
fun AppRoot() {
    var currentScreen by remember { mutableStateOf<Screen>(Screen.ChatsTab) }

    Scaffold(
        bottomBar = {
            if (currentScreen !is Screen.ChatDetail) {
                NavigationBar {
                    NavigationBarItem(
                        selected = currentScreen is Screen.ChatsTab,
                        onClick = { currentScreen = Screen.ChatsTab },
                        icon = { Icon(Icons.Filled.Chat, contentDescription = null) },
                        label = { Text("چت‌ها") }
                    )
                    NavigationBarItem(
                        selected = currentScreen is Screen.ContactsTab,
                        onClick = { currentScreen = Screen.ContactsTab },
                        icon = { Icon(Icons.Filled.People, contentDescription = null) },
                        label = { Text("مخاطبین") }
                    )
                    NavigationBarItem(
                        selected = currentScreen is Screen.SettingsTab,
                        onClick = { currentScreen = Screen.SettingsTab },
                        icon = { Icon(Icons.Filled.Settings, contentDescription = null) },
                        label = { Text("تنظیمات") }
                    )
                }
            }
        }
    ) { padding ->
        Box(modifier = Modifier.padding(padding)) {
            when (val screen = currentScreen) {
                is Screen.ChatsTab -> ChatListScreen(
                    onChatClick = { chat -> currentScreen = Screen.ChatDetail(chat) }
                )
                is Screen.ContactsTab -> ContactsScreen()
                is Screen.SettingsTab -> SettingsScreen()
                is Screen.ChatDetail -> ChatDetailScreen(
                    chat = screen.chat,
                    onBack = { currentScreen = Screen.ChatsTab }
                )
            }
        }
    }
}package com.example.payamyar

